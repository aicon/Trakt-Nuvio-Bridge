# Copy to .env and fill in the Trakt app Client ID.
# This app signs in with PKCE. Trakt does not issue a client secret.
# The redirect must match the Trakt app exactly.
# Plain http:// is allowed only for localhost and 127.0.0.1.

HOST_PORT=4173
VERSION=latest

TRAKT_CLIENT_ID=your_trakt_client_id
TRAKT_REDIRECT_URI=http://127.0.0.1:4173/api/trakt/callback
TRAKT_CALLBACK_ORIGIN=http://127.0.0.1:4173

# Optional build metadata
# BUILD_DATE=2026-06-06
